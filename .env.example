# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only secrets (never commit, never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the audio/artwork bucket (e.g. https://media.example.com). Unset = media shows as unavailable.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Server-only R2 upload credentials (bucket-scoped token). Never NEXT_PUBLIC_.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=emerg-audio
